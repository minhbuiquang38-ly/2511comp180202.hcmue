:root{--teal:#0d9488;--sea:#0284c7;--deep:#0b3a4a;--bg:#f8fafc;--ink:#0f2a33;--mute:#5b7480;--line:#dbe5ea;--cta:#f97316;--gold:#eab308;--r:14px}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font:400 16px/1.65 Inter,Roboto,sans-serif;color:var(--ink);background:#fff}
h1,h2,h3,.logo{font-family:'Be Vietnam Pro',Montserrat,sans-serif;line-height:1.25}
a{color:inherit;text-decoration:none}img{max-width:100%;display:block}
.wrap{width:min(1180px,92%);margin:auto}
.sec{padding:64px 0}.center{text-align:center;margin-top:32px}
.sec-title{font-size:clamp(1.6rem,3vw,2.2rem);margin-bottom:28px}
:focus-visible{outline:3px solid var(--gold);outline-offset:2px}

/* buttons */
.btn{display:inline-block;border:0;border-radius:999px;padding:12px 26px;font:600 15px 'Be Vietnam Pro',sans-serif;cursor:pointer;transition:background .25s,transform .25s,color .25s}
.btn-cta{background:var(--cta);color:#fff}.btn-cta:hover{background:#ea580c;transform:translateY(-2px)}
.btn-line{border:2px solid var(--teal);color:var(--teal);background:none}.btn-line:hover{background:var(--teal);color:#fff}

/* navbar */
#site-header{position:sticky;top:0;z-index:50;background:rgba(255,255,255,.94);backdrop-filter:blur(8px);border-bottom:1px solid var(--line)}
.nav{display:flex;align-items:center;gap:24px;height:68px}
.logo{display:flex;align-items:center;gap:10px;font-weight:800;font-size:1.2rem;color:var(--deep)}
.logo i{width:34px;height:34px;border-radius:50%;background:linear-gradient(135deg,var(--teal),var(--sea))}
.menu{display:flex;gap:6px;margin:0 auto}
.menu a{padding:8px 14px;border-radius:999px;font-weight:500;transition:background .25s,color .25s}
.menu a:hover{background:#e6f4f2;color:var(--teal)}
.menu a.on{background:var(--teal);color:#fff}
.user{display:flex;align-items:center;gap:10px;font-weight:600;font-size:.95rem}
.user .btn{padding:8px 18px}
.burger{display:none;background:none;border:0;font-size:28px;cursor:pointer;margin-left:auto}

/* hero */
.hero{position:relative;min-height:560px;display:flex;align-items:center;color:#fff;overflow:hidden}
.slide{position:absolute;inset:0;background-size:cover;background-position:center;opacity:0;transition:opacity 1.2s}
.slide.on{opacity:1}
.slide::after{content:"";position:absolute;inset:0;background:linear-gradient(to top,rgba(5,30,40,.72),rgba(5,30,40,.15))}
.s1{background-image:url(../images/banner.jpg),linear-gradient(135deg,#0d9488,#0284c7)}
.s2{background-image:url(../images/banner-2.jpg),linear-gradient(135deg,#0284c7,#0b3a4a)}
.s3{background-image:url(../images/banner-3.jpg),linear-gradient(135deg,#0b3a4a,#0d9488)}
.hero-txt{position:relative;z-index:2;padding-bottom:50px}
.hero h1{font-size:clamp(2.2rem,5.5vw,4rem);max-width:15ch;font-weight:800;animation:rise .9s both}
.hero p{margin:16px 0 28px;font-size:1.15rem;max-width:44ch;animation:rise .9s .2s both}
.hero .btn{animation:rise .9s .4s both}
@keyframes rise{from{opacity:0;transform:translateY(34px)}to{opacity:1;transform:none}}
.wave{position:absolute;bottom:-1px;left:0;width:100%;height:70px;z-index:3}

/* page head */
.page-head{background:linear-gradient(120deg,var(--teal),var(--sea));color:#fff;padding:44px 0}
.page-head h1{font-size:2.2rem}.crumb{opacity:.9;font-size:.95rem}.crumb a:hover{text-decoration:underline}

/* cards */
.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:26px}
.card{background:#fff;border:1px solid var(--line);border-radius:var(--r);overflow:hidden;display:flex;flex-direction:column;transition:box-shadow .3s}
.card:hover{box-shadow:0 14px 34px rgba(2,132,199,.15)}
.thumb{aspect-ratio:4/3;overflow:hidden;position:relative;background:linear-gradient(135deg,var(--teal),var(--sea))}
.thumb img{width:100%;height:100%;object-fit:cover;transition:transform .5s}
.card:hover .thumb img{transform:scale(1.05)}
.badge{display:inline-block;background:var(--gold);color:#2b2200;font:700 12px 'Be Vietnam Pro',sans-serif;padding:3px 12px;border-radius:999px}
.thumb .badge{position:absolute;top:12px;left:12px;z-index:2}
.card-b{padding:18px;display:flex;flex-direction:column;gap:8px;flex:1}
.card-b h3{font-size:1.1rem}
.card-b p{color:var(--mute);font-size:.94rem;flex:1}
.acts{display:flex;gap:10px;margin-top:6px}
.acts .btn{padding:8px 18px;font-size:14px}
.btn-del{background:none;color:#b91c1c;border:1px solid #fecaca}.btn-del:hover{background:#fee2e2}

/* experience */
.exp{background:var(--bg)}
.exp-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:22px}
.exp-item{padding:24px;border-left:4px solid var(--teal);background:#fff;border-radius:0 var(--r) var(--r) 0}
.exp-item:nth-child(even){border-color:var(--cta)}
.exp-item h3{margin-bottom:8px;font-size:1.05rem}

/* about */
.two-col{display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:center}.two-col.top{align-items:start}
.ph-img{aspect-ratio:4/3;border-radius:var(--r);overflow:hidden;background:linear-gradient(135deg,var(--teal),var(--sea))}
.ph-img img{width:100%;height:100%;object-fit:cover}
.two-col p{margin-top:12px}
.stats{background:var(--deep);color:#fff;padding:40px 0}
.stat-row{display:flex;justify-content:space-around;text-align:center;gap:20px}
.stat-row b{display:block;font:800 2.6rem 'Be Vietnam Pro',sans-serif;color:var(--gold)}
.team{display:grid;grid-template-columns:repeat(5,1fr);gap:20px;text-align:center}
.avatar{width:96px;height:96px;margin:0 auto 12px;border-radius:50%;background:linear-gradient(135deg,var(--teal),var(--sea))}
.member p{color:var(--mute);font-size:.9rem}

/* toolbar */
.toolbar{display:flex;flex-wrap:wrap;gap:12px;align-items:center;margin-bottom:12px}
.toolbar input,.toolbar select{padding:11px 16px;border:1px solid var(--line);border-radius:999px;font:inherit;background:#fff}
.toolbar input{flex:1;min-width:200px}
.chips{display:flex;gap:8px;flex-wrap:wrap}
.chip{padding:8px 16px;border:1px solid var(--line);background:#fff;border-radius:999px;cursor:pointer;font:500 14px Inter;transition:all .25s}
.chip:hover{border-color:var(--teal);color:var(--teal)}
.chip.on{background:var(--teal);border-color:var(--teal);color:#fff}
.count{color:var(--mute);margin:8px 0 20px}
.empty{text-align:center;padding:40px;color:var(--mute)}

/* modal */
.modal{position:fixed;inset:0;background:rgba(5,30,40,.6);display:flex;align-items:center;justify-content:center;z-index:100;padding:16px;animation:fade .25s}
.modal[hidden]{display:none}
.box{background:#fff;border-radius:var(--r);width:min(560px,100%);max-height:90vh;overflow:auto;padding:26px;position:relative;animation:rise .3s}
.box h2{margin:10px 0}
.x{position:absolute;top:10px;right:14px;background:none;border:0;font-size:30px;cursor:pointer;z-index:3}
.d-img{aspect-ratio:16/9;border-radius:10px;overflow:hidden;background:linear-gradient(135deg,var(--teal),var(--sea));margin-bottom:12px}
.d-img img{width:100%;height:100%;object-fit:cover}
@keyframes fade{from{opacity:0}}

/* forms */
.card-form{background:var(--bg);border:1px solid var(--line);border-radius:var(--r);padding:24px;margin-top:16px}
form label{display:block;font-weight:600;font-size:.9rem;margin-bottom:14px}
form input,form textarea,form select{display:block;width:100%;margin-top:6px;padding:11px 14px;border:1px solid var(--line);border-radius:10px;font:inherit;background:#fff}
form input:focus,form textarea:focus,form select:focus,.toolbar input:focus{border-color:var(--teal);outline:0;box-shadow:0 0 0 3px #99f6e4}
.tabs{display:flex;gap:6px;margin-bottom:18px;border-bottom:2px solid var(--line)}
.tab{flex:1;padding:10px;background:none;border:0;border-bottom:3px solid transparent;margin-bottom:-2px;font:600 14px 'Be Vietnam Pro',sans-serif;cursor:pointer;color:var(--mute)}
.tab.on{color:var(--teal);border-color:var(--teal)}
.pane{display:none}.pane.on{display:block}
.notice{margin-top:14px;padding:10px 14px;border-radius:10px;background:#ffedd5;border-left:4px solid var(--cta);font-weight:500}
.notice.err{background:#fee2e2;border-color:#dc2626}

/* footer */
footer{background:var(--deep);color:#cfe3e8;padding:48px 0 20px}
.f-grid{display:grid;grid-template-columns:2fr 1fr 1.4fr;gap:36px}
footer h4{color:#fff;margin-bottom:12px;font-family:'Be Vietnam Pro'}
footer li{list-style:none;margin-bottom:6px}footer a:hover{color:var(--gold)}
.copy{border-top:1px solid rgba(255,255,255,.15);margin-top:30px;padding-top:16px;text-align:center;font-size:.88rem}

@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
