<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Điểm đến · Việt Hành</title><link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@500;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet"><link rel="stylesheet" href="css/style.css"><link rel="stylesheet" href="css/responsive.css"></head><body><header id="site-header"></header><main>
<header class="page-head"><div class="wrap"><h1>Điểm đến</h1><p class="crumb"><a href="index.html">Trang chủ</a> / Điểm đến</p></div></header>
<section class="wrap sec">
  <div class="toolbar">
    <input id="q" type="search" placeholder="Tìm điểm đến...">
    <select id="type"><option value="">Tất cả loại hình</option></select>
    <div class="chips" id="chips">
      <button class="chip on" data-region="">Tất cả</button><button class="chip" data-region="Miền Bắc">Miền Bắc</button><button class="chip" data-region="Miền Trung">Miền Trung</button><button class="chip" data-region="Miền Nam">Miền Nam</button>
    </div>
    <button class="btn btn-cta" id="btn-add">+ Thêm điểm đến</button>
  </div>
  <p class="count" id="count"></p>
  <div class="grid" id="list"></div>
  <p class="empty" id="empty" hidden>Không tìm thấy điểm đến phù hợp. Hãy thử từ khoá khác.</p>
</section>

<div class="modal" id="m-detail" hidden><div class="box">
  <button class="x" data-close>&times;</button>
  <div class="d-img" id="d-img"></div>
  <span class="badge" id="d-region"></span><h2 id="d-name"></h2>
  <p id="d-desc"></p><p><b>Check-in / món ngon:</b> <span id="d-extra"></span></p>
</div></div>

<div class="modal" id="m-add" hidden><div class="box">
  <button class="x" data-close>&times;</button><h2>Thêm điểm đến</h2>
  <form id="f-add">
    <label>Tên<input name="name" required></label>
    <label>Vùng miền<select name="region"><option>Miền Bắc</option><option>Miền Trung</option><option>Miền Nam</option></select></label>
    <label>Loại hình<input name="type" placeholder="Biển, núi, văn hoá..."></label>
    <label>Đường dẫn ảnh<input name="img" placeholder="images/product-26.jpg"></label>
    <label>Mô tả<textarea name="desc" rows="4" required></textarea></label>
    <button class="btn btn-cta" type="submit">Lưu điểm đến</button>
  </form>
</div></div>
</main><footer id="site-footer"></footer><script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script><script src="js/main.js"></script></body></html>
